{
  "name": "@afallon-compendium/site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/ensure-sveltekit-folder.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "SVELTE_KIT_OUT_DIR=.svelte-kit-build vite build",
    "build:production": "SITE_STAGE=production SVELTE_KIT_OUT_DIR=.svelte-kit-build vite build",
    "preview": "SVELTE_KIT_OUT_DIR=.svelte-kit-build vite preview --host 127.0.0.1",
    "preview:production": "bun run build:production && bun run scripts/preview-production.ts",
    "check": "SVELTE_KIT_OUT_DIR=.svelte-kit-check svelte-kit sync && SVELTE_KIT_OUT_DIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json && bun scripts/check-template-whitespace.ts",
    "stage:production": "bun run scripts/stage-publication.ts",
    "assert:deployment": "bun run scripts/assert-deployment.ts",
    "verify:deployment": "bun run scripts/verify-deployment.ts",
    "deploy:production": "bun run scripts/deploy-production.ts",
    "rollback:production": "wrangler rollback"
  },
  "dependencies": {
    "@afallon/contracts": "workspace:*",
    "@deck.gl/core": "9.3.7",
    "@deck.gl/geo-layers": "9.3.7",
    "@deck.gl/layers": "9.3.7",
    "@floating-ui/dom": "^1.8.0",
    "@math.gl/core": "4.1.0",
    "lucide": "0.577.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "htmlparser2": "^12.0.0",
    "playwright-core": "1.58.2",
    "svelte": "5.57.0",
    "svelte-check": "4.4.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.131.1"
  }
}
