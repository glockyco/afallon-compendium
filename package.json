{
  "name": "afallon-compendium",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "compendium": "bun apps/compendium-cli/src/cli.ts",
    "dev": "bun run --cwd apps/site dev",
    "build": "bun run --cwd apps/site build",
    "build:production": "bun run --cwd apps/site build:production",
    "preview": "bun run --cwd apps/site preview",
    "stage:production": "bun apps/site/scripts/stage-publication.ts",
    "verify:deployment": "bun apps/site/scripts/verify-deployment.ts",
    "deploy:production": "bun apps/site/scripts/deploy-production.ts",
    "rollback:production": "bun run --cwd apps/site rollback:production",
    "check": "tsc -b tsconfig.packages.json",
    "check:packages": "tsc -b tsconfig.packages.json",
    "check:dependencies": "depcruise --config .dependency-cruiser.cjs apps/compendium-cli/src apps/site/src packages/*/src",
    "test": "bun test ./packages ./apps && bun run test:python",
    "test:python": "uv run --locked python -m unittest discover -s packages/scan/src -p '*_test.py'"
  },
  "overrides": {
    "@deck.gl/extensions": "9.3.7",
    "@deck.gl/mesh-layers": "9.3.7",
    "@luma.gl/core": "9.3.3",
    "@luma.gl/engine": "9.3.3",
    "@luma.gl/gltf": "9.3.3",
    "@luma.gl/shadertools": "9.3.3",
    "@luma.gl/webgl": "9.3.3"
  },
  "dependencies": {
    "@afallon/artifacts": "workspace:*",
    "@afallon/capture": "workspace:*",
    "@afallon/catalog": "workspace:*",
    "@afallon/contracts": "workspace:*",
    "@afallon/runtime": "workspace:*",
    "@hotrepl/protocol": "4.0.1",
    "@hotrepl/sdk": "4.0.1",
    "sharp": "0.35.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "dependency-cruiser": "^18.3.0",
    "typescript": "5.9.3"
  }
}
