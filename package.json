{
  "name": "afallon-compendium",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "compendium": "bun tools/cli.ts",
    "check": "tsc --noEmit && tsc -b tsconfig.packages.json",
    "check:packages": "tsc -b tsconfig.packages.json",
    "check:dependencies": "depcruise --config .dependency-cruiser.cjs apps/compendium-cli/src apps/site/src packages/*/src",
    "test": "bun test"
  },
  "overrides": {
    "@deck.gl/extensions": "9.3.7",
    "@deck.gl/mesh-layers": "9.3.7",
    "@luma.gl/core": "9.3.3",
    "@luma.gl/engine": "9.3.3",
    "@luma.gl/gltf": "9.3.3",
    "@luma.gl/shadertools": "9.3.3",
    "@luma.gl/webgl": "9.3.3"
  },
  "dependencies": {
    "@afallon/capture": "workspace:*",
    "@afallon/contracts": "workspace:*",
    "@afallon/runtime": "workspace:*",
    "@hotrepl/protocol": "4.0.1",
    "@hotrepl/sdk": "4.0.1",
    "sharp": "0.35.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "dependency-cruiser": "^18.3.0",
    "typescript": "5.9.3"
  }
}
